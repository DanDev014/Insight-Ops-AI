# Copy this file to ".env" and fill in your Neon branch connection string.
# cp .env.example .env

DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Set to "true" to run on generated sample data instead of the live DB.
# Great for demos or before the DB is populated. Leave "false" for production.
USE_SAMPLE_DATA="false"
